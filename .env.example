# ---------------------------------------------------------------------------
# OrbitPlay API — example environment.
# Copy to `.env`:  cp .env.example .env
#
# Values below are LOCAL-DEV THROWAWAY values so the documented flow works out
# of the box (they match docker/compose.yml). They are NOT secrets and must
# NEVER be used in staging/production. The boot-time Zod validation
# (src/config/env.schema.ts) treats every variable here as REQUIRED: delete a
# line and the app fails fast on boot, pointing at the missing variable.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# --- Database (Postgres) ---
DATABASE_URL=postgres://orbitplay:orbitplay@localhost:5432/orbitplay

# --- Redis (BullMQ + idempotency store) ---
REDIS_URL=redis://localhost:6379

# --- Auth / JWT (dev-only throwaway secrets) ---
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# --- Object storage (MinIO — S3 protocol) ---
# NOTE: no S3_ prefix on purpose — MinIO is the storage everywhere, the S3 SDK
# is only the protocol client. Keep path-style addressing on for MinIO.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=orbitplay-dev
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# --- Mail (Mailhog dev SMTP) ---
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@orbitplay.dev

# --- CORS: the web front origin allowed to call this API ---
WEB_ORIGIN=http://localhost:5173

# --- Rate limiting (auth endpoints) ---
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=5
