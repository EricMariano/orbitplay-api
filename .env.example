# ---------------------------------------------------------------------------
# OrbitPlay API — example environment.
# Copy to `.env`:  cp .env.example .env
#
# Values below are LOCAL-DEV THROWAWAY values so the documented flow works out
# of the box (they match docker/compose.yml). They are NOT secrets and must
# NEVER be used in staging/production. The boot-time Zod validation
# (src/config/env.schema.ts) treats every variable here as REQUIRED: delete a
# line and the app fails fast on boot, pointing at the missing variable.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# --- Database (Postgres) ---
DATABASE_URL=postgres://orbitplay:orbitplay@localhost:5432/orbitplay

# --- Redis (BullMQ + idempotency store) ---
REDIS_URL=redis://localhost:6379

# --- Auth / JWT (dev-only throwaway secrets) ---
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# --- Object storage (MinIO — S3 protocol) ---
# NOTE: no S3_ prefix on purpose — MinIO is the storage everywhere, the S3 SDK
# is only the protocol client. Keep path-style addressing on for MinIO.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=orbitplay-dev
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# --- Mail (Mailhog dev SMTP) ---
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@orbitplay.dev

# --- CORS: web front origins allowed to call this API (comma-separated) ---
# The first one is canonical: e-mail links (password reset, invites) use it.
WEB_ORIGIN=http://localhost:5173,http://localhost:5199

# --- Rate limiting (auth endpoints) ---
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=5
# Stricter limits for GET /auth/signup/availability (anti-enumeration)
AUTH_AVAILABILITY_THROTTLE_TTL=60
AUTH_AVAILABILITY_THROTTLE_LIMIT=3

# --- Proxy reverso (Express "trust proxy") ---
# Quantos proxies (load balancer, ingress) ficam na frente da API. Com 1+, o
# req.ip — usado no rate limit por IP do login e no audit log — sai do
# X-Forwarded-For; sem isso, atrás de um LB todo cliente teria o IP do proxy
# (o limite de logins viraria global). "false" (padrão se a linha faltar) não
# confia em nenhum cabeçalho: certo quando a API é exposta direto, pois o
# cliente poderia forjar o próprio IP. "true" (confiar em tudo) é recusado.
TRUST_PROXY=false

# --- Password reset (one-time token lifetime) ---
PASSWORD_RESET_TTL=1h

# --- Chat em tempo real (flood control por usuário, via Redis) ---
CHAT_MESSAGE_THROTTLE_TTL=10
CHAT_MESSAGE_THROTTLE_LIMIT=10

# --- Builds: verificação de malware (ClamAV / clamd) ---
# O worker envia cada build ao clamd (docker compose: serviço "clamav").
# Em produção CLAMD_HOST é obrigatório. Build maior que CLAMD_MAX_SCAN_BYTES
# (ou que o limite do próprio clamd) reprova como "não verificável".
CLAMD_HOST=localhost
CLAMD_PORT=3310
CLAMD_TIMEOUT_MS=600000
CLAMD_MAX_SCAN_BYTES=1073741824

# --- Builds: pular a verificação de malware (SÓ desenvolvimento) ---
# true troca o clamd por um scanner que marca o passo como pulado ("PULADA",
# nunca "aprovada") e valida a build — útil sem o container clamav rodando.
# A API se recusa a subir com true em NODE_ENV=production.
BUILD_MALWARE_SCAN_BYPASS=false
